# --- LLM providers ---------------------------------------------------------
# At least one is needed for structured extraction. Without both, SENTINEL
# falls back to rules-only output and flags the result as low confidence.
# aistudio.google.com -> "Get API key"
GEMINI_API_KEY=your_key_here
# console.groq.com -> API Keys
GROQ_API_KEY=your_key_here

# --- Vector store ----------------------------------------------------------
# Leave QDRANT_URL empty to use the built-in local index (an exact numpy search
# over data/vectors_*.npz). That is the right choice up to roughly 100k chunks.
# Set it only for a corpus large enough that approximate search pays off.
# cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# --- Database --------------------------------------------------------------
# Unset means a local SQLite file. For Supabase, use the pooled connection
# string from Project Settings -> Database, with the asyncpg driver:
# DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/postgres

# --- Cache (optional) ------------------------------------------------------
# Falls back to an in-process dict, which is fine on a single instance.
# console.upstash.com -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Set to true ONLY behind a proxy you control (Render, Vercel, your own nginx).
# Exposed directly to the internet it lets a caller forge X-Forwarded-For and
# bypass the rate limit.
TRUST_PROXY_HEADERS=false

# --- Limits ----------------------------------------------------------------
MAX_ANALYSES_PER_IP_PER_HOUR=10
ANALYSIS_CACHE_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=300
MAX_EXTRACTED_CHARS=500000
ANALYSIS_TIMEOUT_SECONDS=180
STREAM_TIMEOUT_SECONDS=300

# --- LLM models ------------------------------------------------------------
# Defaults are floating aliases so a retired model version does not break the
# app. Pin a specific version here only if you need reproducible output.
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-20b

# --- Models ----------------------------------------------------------------
# "blank" = tokeniser + the safety entity ruler, no statistical model and no
# download. Measured to find every entity this domain uses. Set en_core_web_sm
# or en_core_web_lg only if you want general-purpose NER layered on top.
SPACY_MODEL=blank

# --- Collection names ------------------------------------------------------
INCIDENTS_COLLECTION=sentinel_incidents
REGULATORY_COLLECTION=sentinel_regulatory
